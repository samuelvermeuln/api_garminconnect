# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_API_ENCRYPTION_KEY=

# Admin key protects account creation/MFA endpoints.
GARMIN_API_ADMIN_KEY=
GARMIN_API_PORT=8001
GARMIN_API_STORAGE=your_data/garmin_api
GARMIN_API_DATABASE=your_data/garmin_api/garmin_api.sqlite3
GARMIN_API_CACHE_TTL_SECONDS=120

# Account API key returned by POST /accounts after Garmin login.
GARMIN_API_KEY=

# Used by the Garmin MCP container to call the Garmin API container.
GARMIN_API_BASE_URL=http://garmin-api:8000

# Optional Garmin MCP HTTP service for n8n/LLM clients.
GARMIN_MCP_PORT=8010
GARMIN_MCP_PATH=/mcp
GARMIN_MCP_BEARER_TOKEN=
GARMIN_MCP_MAX_RESPONSE_CHARS=12000
GARMIN_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,garmin-mcp,167.86.116.131,167.86.116.131:8010,n8n.holdingtech.com.br
GARMIN_MCP_ALLOWED_ORIGINS=https://n8n.holdingtech.com.br
