# Required to run docker-compose.
# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_API_ENCRYPTION_KEY=

# Recommended to protect account creation and MFA endpoints.
GARMIN_API_ADMIN_KEY=

# Host/container port for the Garmin API service.
GARMIN_API_PORT=8001

# Allowed Host headers for the API, comma-separated.
# Include localhost for healthchecks and your public domain/IP for real traffic.
GARMIN_API_ALLOWED_HOSTS=localhost,127.0.0.1
